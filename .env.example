# Database Configuration
MONGODB_URI=mongodb://admin:password123@mongodb:27017/proctoring?authSource=admin
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_DATABASE=proctoring

# Redis Configuration
REDIS_URL=redis://:redis123@redis:6379/0
REDIS_PASSWORD=redis123

# RabbitMQ Configuration
RABBITMQ_URL=amqp://admin:rabbit123@rabbitmq:5672/
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=rabbit123
RABBITMQ_VHOST=/

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://frontend:3000,http://localhost:80,https://yourdomain.com

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
ENABLE_CELERY_WORKER=true

# AI Detection Configuration
AI_CONFIDENCE_THRESHOLD=0.5
AI_MAX_PROCESSING_FPS=10
AI_AUTO_ALERT_THRESHOLD=70

# File Storage Configuration
STORAGE_TYPE=local
# For AWS S3 (alternative to local storage)
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=proctoring-storage

# Security Configuration
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_CONTENT_TYPE_NOSNIFF=true
SECURE_BROWSER_XSS_FILTER=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Monitoring Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana123

# SSL Configuration (for production)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
